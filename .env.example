# ----- LLM（必填） -----
OPENAI_API_KEY=sk-proj-xxxx
OPENAI_MODEL=gpt-4.1-mini
# 選填：改用 Azure / Groq / 本地 OpenAI 相容 API 時設定
# OPENAI_BASE_URL=https://your-api.example.com/v1

# ----- SVN 與工作區（可依部門／環境調整） -----
# SVN 伺服器根 URL，結尾會自動加 /
SVN_BASE_URL=https://svn1.embestor.local/svn/
# 本機 svn 執行檔路徑
SVN_EXE_PATH=C:\Program Files\TortoiseSVN\bin\svn.exe
# 工作區根目錄（checkout、檔案操作皆限制在此底下）
WORKSPACE_ROOT=D:\Projects\AutoMerge
# svn 輸出編碼（Windows 繁中常用 cp950）
SVN_ENCODING=cp950
# svn 指令逾時秒數
SVN_TIMEOUT_SECONDS=120

# ----- Branch / Trunk 目錄命名（若與預設不同可改） -----
# branch 目錄名稱，多個以逗號分隔，例如 branches 或 branch,br
SVN_BRANCH_DIR_NAMES=branches
# trunk 目錄名稱
SVN_TRUNK_NAME=trunk
